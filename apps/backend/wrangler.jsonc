{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "financeanchor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Nur die feste Adresse; keine Vorschau-Adressen je Version (gleiche Datenbank)
  "workers_dev": true,
  "preview_urls": false,
  // Die Angular-App wird als statische Assets ausgeliefert; nur /api/* läuft durch den Worker.
  // Gleiche Origin für App und API: keine Third-Party-Cookies, CORS nur für Entwicklung/Capacitor.
  "assets": {
    "directory": "../web/dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "financeanchor",
      // Produktion: D1 in der EU (--jurisdiction eu)
      "database_id": "651a0b78-1710-418a-aec0-f098059f624a",
      // Lokale Entwicklung (wrangler dev, --local) nutzt diese ID als Dateinamen der lokalen D1;
      // fester Wert, damit lokale Daten nicht von der Produktions-ID abhängen.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Login-Versuche je IP. Zusätzlich begrenzt Better Auth selbst (Speicher: D1).
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "ALLOW_SIGNUP": "false",
    "ALLOWED_ORIGINS": "http://localhost:4200",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
}
