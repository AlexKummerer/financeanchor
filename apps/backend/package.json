{
  "name": "@financeanchor/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('node:fs').mkdirSync('../web/dist/web/browser',{recursive:true})\" && wrangler dev",
    "test": "vitest run",
    "typecheck": "wrangler types --strict-vars=false --env-file .dev.vars.example --check && tsc --noEmit",
    "types": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx scripts/seed.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.4",
    "@types/node": "^24.13.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.137.0"
  },
  "dependencies": {
    "@financeanchor/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  }
}
