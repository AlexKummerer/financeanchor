{
  "name": "@financeanchor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.137.0"
  },
  "dependencies": {
    "@financeanchor/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  }
}
